    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@relay-protocol/eslint-config": "workspace:*",
    "@relay-protocol/tsconfig": "workspace:*",
    "eslint": "9.36.0",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@relay-protocol/types": "workspace:*",
    "@reservoir0x/relay-protocol-sdk": "0.0.44"
  }
}
