PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/relay_settlement_indexer
RPC_WS_URL=wss://your-rpc-provider.example/rpc
# RPC_HTTP_URL=https://your-rpc-provider.example/rpc
ORACLE_API_URL=https://oracle.relay.link
AUTH_API_KEY=
ALLOW_UNAUTHENTICATED_API=0
ENABLE_API=0
DO_BACKGROUND_WORK=1
BATCH_SIZE=2000
HEALTH_MAX_LAG_BLOCKS=500
POLL_INTERVAL_MS=5000
DEPOSITORY_BALANCE_AUDIT_INTERVAL_MS=600000

# Chain RPCs used by the worker's depository balance audit. The variable name
# is the uppercased chain id returned by $ORACLE_API_URL/chains/v1.
# ETHEREUM_RPC_URL=https://your-ethereum-rpc-provider.example/rpc
# BASE_RPC_URL=https://your-base-rpc-provider.example/rpc
# ARBITRUM_NOVA_RPC_URL=https://your-arbitrum-nova-rpc-provider.example/rpc
# BITCOIN_RPC_URL=https://your-bitcoin-rpc-provider.example/rpc
# HYPERLIQUID_RPC_URL=https://your-hyperliquid-api.example
# LIGHTER_RPC_URL=https://your-lighter-api.example
# SOLANA_RPC_URL=https://your-solana-rpc-provider.example/rpc
# TON_RPC_URL=https://your-ton-rpc-provider.example/rpc
# TRON_RPC_URL=https://your-tron-rpc-provider.example/rpc
# XRP_RPC_URL=https://your-xrp-rpc-provider.example/rpc

# Optional overrides. Relay defaults come from @relay-protocol/settlement-networks.
# START_BLOCK=1215200
# HUB_START_BLOCK=1215200
# ORACLE_START_BLOCK=1215200
# HUB_CONTRACT_ADDRESS=0xddd361727c22a01eb137880678a20b0beae69318
# ORACLE_CONTRACT_ADDRESS=0xd4b9fdb83c723c096d7fbe72da252aa23f1387aa
