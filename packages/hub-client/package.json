{
  "name": "@relay-settlement/hub-client",
  "version": "0.0.2",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@relay-settlement/abis": "workspace:*",
    "@relay-settlement/hub-utils": "workspace:*",
    "@reservoir0x/relay-protocol-sdk": "0.0.55",
    "ethers": "6.15.0"
  },
  "scripts": {
    "start": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "lint",
    "build": "tsup src/index.ts --dts --format esm,cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@relay-settlement/eslint-config": "workspace:*",
    "@relay-settlement/tsconfig": "workspace:*",
    "eslint": "9.36.0",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
