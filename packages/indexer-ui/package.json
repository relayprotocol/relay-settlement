{
  "name": "@relay-settlement/indexer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "generate": "openapi-typescript \"${INDEXER_API_URL:-http://localhost:3001}/api/v1/api_docs/openapi.json\" --root-types --root-types-no-schema-prefix -o src/api/schema.d.ts && lint --fix",
    "lint": "lint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.104.0",
    "lucide-react": "1.61.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@relay-settlement/eslint-config": "workspace:*",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.0",
    "@types/node": "24.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "rolldown": "1.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
