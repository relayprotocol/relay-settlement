{
  "name": "@relay-protocol/smart-contracts",
  "scripts": {
    "build": "yarn hardhat compile",
    "build:abis": "yarn hardhat export:abis",
    "test": "hardhat test",
    "coverage": "SOLIDITY_COVERAGE=true hardhat coverage",
    "lint:contracts": "solhint 'contracts/**/*.sol'",
    "lintFix": "yarn lint:contracts --fix --noPrompt && yarn lint:code --fix",
    "lint:code": "eslint .",
    "lint": "yarn lint:contracts && yarn lint:code",
    "prettier": "prettier --write --plugin=prettier-plugin-solidity 'contracts/**/*.sol'"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "0.15.11",
    "@nomicfoundation/hardhat-ignition-viem": "0.15.11",
    "@nomicfoundation/hardhat-network-helpers": "1.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "3.0.0",
    "@nomicfoundation/hardhat-verify": "2.0.1",
    "@nomicfoundation/hardhat-viem": "2.0.6",
    "@types/chai": "4.2.0",
    "@types/chai-as-promised": "7.1.6",
    "@types/fs-extra": "^11",
    "@types/mocha": "9.1.0",
    "@types/node": "18.0.0",
    "chai": "4.2.0",
    "eslint": "9.19.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-evm-address-to-checksummed": "0.0.6",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-mocha": "10.5.0",
    "eslint-plugin-prettier": "5.2.3",
    "hardhat": "2.23.0",
    "hardhat-gas-reporter": "1.0.8",
    "prettier": "3.5.3",
    "prettier-plugin-solidity": "2.0.0",
    "solhint": "5.1.0",
    "solidity-coverage": "0.8.16",
    "ts-node": "8.0.0",
    "typescript": "5.0.4",
    "viem": "2.7.6"
  },
  "dependencies": {
    "@nomiclabs/hardhat-solhint": "4.0.1",
    "@openzeppelin/contracts": "5.3.0",
    "@relay-protocol/fixtures": "workspace:*",
    "@relay-protocol/hub-utils": "workspace:*",
    "@relay-protocol/networks": "workspace:*",
    "bip32": "5.0.0-rc.0",
    "bip39": "3.1.0",
    "bitcoinjs-lib": "6.1.7",
    "bs58check": "4.0.0",
