    "hardhat": "2.23.0",
    "hardhat-gas-reporter": "2.3.0",
    "prettier": "3.5.3",
    "prettier-plugin-solidity": "2.1.0",
    "solhint": "6.0.1",
    "solidity-coverage": "0.8.16",
    "ts-node": "8.0.0",
    "typescript": "5.0.4",
    "viem": "2.37.3"
